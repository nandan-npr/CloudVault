# ============================================================================
# SERVER & DATABASE
# ============================================================================

# Server port
PORT=5000

# Node environment (development, test, production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Get from MongoDB Atlas > Deployment > Database > Connect > Driver > Connection String
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/cloudvault?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT secret (must be at least 32 characters for security)
JWT_SECRET=replace-with-a-random-32-character-minimum-secret-key-here

# Frontend URL (used for CORS and password reset links)
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Cookie security settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================================================
# FILE STORAGE & CLOUDINARY
# ============================================================================

# Local temporary file storage directory
FILE_STORAGE_DIR=uploads

# Maximum file size in MB (1-500)
MAX_FILE_SIZE_MB=50

# Cloudinary API credentials (get from https://cloudinary.com/console/settings/api-keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# EMAIL SERVICE - Resend
# ============================================================================

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Sender email address (must be verified in Resend dashboard)
EMAIL_FROM=noreply@example.com

# ============================================================================
# EMAIL SERVICE - SMTP (Optional/Legacy)
# ============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
SMTP_FROM=no-reply@example.com
